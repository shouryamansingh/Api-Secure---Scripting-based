{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTTP Header Analysis — AI Output",
  "description": "Expected JSON structure returned by the AI agent. Downstream (e.g. Process Audit Results) maps this into the final report.",
  "type": "object",
  "required": ["headers", "summary"],
  "properties": {
    "headers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "present", "value", "severity", "description", "issue", "impact", "recommendation"],
        "properties": {
          "name": { "type": "string" },
          "present": { "type": "boolean" },
          "value": { "type": ["string", "null"] },
          "severity": { "enum": ["critical", "warning", "ok"] },
          "description": { "type": "string" },
          "issue": { "type": "string" },
          "impact": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["criticalCount", "warningCount", "okCount", "totalHeaders"],
      "properties": {
        "criticalCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "okCount": { "type": "integer", "minimum": 0 },
        "totalHeaders": { "type": "integer", "const": 10 }
      }
    }
  }
}
