# Copy to .env and set values. Do not commit .env.

# JWT Authentication — change this in production!
# JWT_SECRET=your-secure-random-secret-key
# JWT_EXPIRY_HOURS=24

# SSL Labs API v4 (required for full certificate/cipher/vulnerability reports)
# Register once: POST https://api.ssllabs.com/api/v4/register
#   body: {"firstName":"..","lastName":"..","email":"..","organization":".."}
# Then add your registered email below. Without this, the scanner falls back to
# the deprecated v3 API and returns reduced results (no certs, no cipher details).
# SSL_LABS_EMAIL=you@yourorganization.com

# FLASK_ENV=development|production
# PORT=3001
# HOST=0.0.0.0

# CORS: comma-separated origins, or * for development only
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Limits
# MAX_URLS_PER_SCAN=50
# MAX_UPLOAD_SIZE_MB=5
# SCANNER_TIMEOUT=15

# Email — choose one: SMTP or Gmail OAuth (Client ID + Client Secret)

# Option A: SMTP (any provider or Gmail with App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=your.email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your.email@gmail.com

# Option B: Gmail OAuth (Client ID + Client Secret from Google Cloud Console)
# 1. Create OAuth 2.0 Web application credentials; add Authorized redirect URIs:
#    http://localhost:8080/  http://localhost:8090/  http://localhost:9090/
#    http://localhost:8765/  http://localhost:9999/   (script uses first free port)
# 2. Run once: py scripts/get_gmail_refresh_token.py  (sign in with the Gmail that will send)
# 3. Add the printed GOOGLE_REFRESH_TOKEN and set GOOGLE_SENDER_EMAIL to that Gmail
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
# GOOGLE_REFRESH_TOKEN=xxx
# GOOGLE_SENDER_EMAIL=your.gmail@gmail.com
